{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dugdhsar-og",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "iconv-lite": "./server/shims/iconv-lite.ts"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "a9e69a8872f34c1988a280944998fc3f" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dugdhsar-prod",
      "database_id": "ecc63e98-7b25-45cf-a1d6-cd7196ae4558",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 3 * * *", "30 12 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://dugdhsar-og.sumitpawar65005.workers.dev"
  }
}
