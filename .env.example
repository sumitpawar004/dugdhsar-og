# Cloudflare Workers / Local Development Environment Variables
# Copy to .dev.vars (for `wrangler dev`) or set in Cloudflare using `npx wrangler secret put <NAME>`.
# NEVER commit real secrets or tokens to Git.

# Public Deployment URL (e.g. https://dugdhsar.in or https://dugdhsar-og.<subdomain>.workers.dev)
APP_URL=""

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Also optional at Vite build time as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Session JWT signing secret (minimum 32 random characters; e.g. `openssl rand -hex 32`)
JWT_SECRET=""

# Primary Owner Admin email(s), comma-separated
SUPER_ADMIN_EMAILS=""

# Real Instagram Account Connection (Meta Developers -> Instagram Graph API)
# Supports BOTH Instagram Login long-lived tokens (IGAA...) and Facebook Graph Business tokens (EAA...)
IG_ACCESS_TOKEN=""
# Optional for EAA... tokens (auto-discovered from linked Facebook Page if omitted)
IG_USER_ID=""
# Optional for automatic EAA... token refresh and webhook HMAC signature verification
IG_APP_ID=""
IG_APP_SECRET=""
IG_VERIFY_TOKEN=""
